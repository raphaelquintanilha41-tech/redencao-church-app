# Copy this file to .env.local and fill in with your Supabase project's
# values (Project Settings → API in the Supabase dashboard).
#
# VITE_SUPABASE_ANON_KEY is the "anon public" key — it is safe to ship in
# client code because every table it can reach is protected by Row Level
# Security (see supabase/migrations). NEVER put the service_role key here
# or anywhere else in this repo — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY